echo " GeoIP              : ${ENABLE_GEOIP}"
echo " Bad ASN            : ${ENABLE_ASN}"
echo " X4B VPN            : ${ENABLE_X4B_VPN}"
echo " X4B Datacenter     : ${ENABLE_X4B_DATACENTER}"
echo " Zone               : ${ZONE}"
echo
echo " Prefix counts:"
[[ "$ENABLE_GEOIP" == true ]] && echo " GeoIP IPv4        : $GEOIP_COUNT" && echo " GeoIP IPv6        : $GEOIP_IP6_COUNT"
[[ "$ENABLE_ASN" == true ]] && echo " ASN IPv4          : $ASN_IP4_COUNT" && echo " ASN IPv6          : $ASN_IP6_COUNT"
[[ "$ENABLE_X4B_VPN" == true ]] && echo " X4B VPN IPv4      : $X4B_VPN_IP4_COUNT" && echo " X4B VPN IPv6      : $X4B_VPN_IP6_COUNT"
[[ "$ENABLE_X4B_DATACENTER" == true ]] && echo " X4B DC IPv4       : $X4B_DATACENTER_IP4_COUNT" && echo " X4B DC IPv6       : $X4B_DATACENTER_IP6_COUNT"
echo
