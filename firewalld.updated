#!/bin/bash

# ============================================================================
# Firewall GeoIP + ASN blocking script for firewalld
#
# GeoIP source:
#   https://www.ipdeny.com/
#
# ASN source:
#   https://github.com/bountyyfi/bad-asn-list
#
# ASN -> network conversion:
#   bgpq4 / IRR routing data
#
# The script creates separate IPv4/IPv6 ipsets for:
#
#   geoip-blacklist-ip4
#   geoip-blacklist-ip6
#   asn-blacklist-ip4
#   asn-blacklist-ip6
#
# All four are attached to the firewalld "drop" zone.
# ============================================================================

set -o pipefail

# ============================================================================
# Configuration
# ============================================================================

# Countries to block.
# Change this to your own list if required.
ZONES="ru by"

# GeoIP ipset names.
GEOIP_BLACKLIST_IP4="geoip-blacklist-ip4"
GEOIP_BLACKLIST_IP6="geoip-blacklist-ip6"

# ASN ipset names.
ASN_BLACKLIST_IP4="asn-blacklist-ip4"
ASN_BLACKLIST_IP6="asn-blacklist-ip6"

# Bad ASN list.
ASN_LIST_URL="https://raw.githubusercontent.com/bountyyfi/bad-asn-list/refs/heads/main/all.txt"

# Temporary working directory.
TMPDIR="/tmp/geoip-blocking"

# Maximum entries for hash:net ipsets.
MAXELEM="200000"

# Hash size.
HASHSIZE="4096"

# ============================================================================
# Colors
# ============================================================================

RED='\033[0;91m'
GREEN='\033[0;92m'
CYAN='\033[0;96m'
YELLOW='\033[0;93m'
PURPLE='\033[0;95m'
BLUE='\033[0;94m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================================
# Helpers
# ============================================================================

log_info() {
    echo -e "[${PURPLE}i${NC}] $1"
}

log_ok() {
    echo -e "[${GREEN}✓${NC}] $1"
}

log_warn() {
    echo -e "[${YELLOW}!${NC}] $1"
}

log_error() {
    echo -e "[${RED}✗${NC}] $1"
}

abort() {
    log_error "$1"
    exit 1
}

cleanup() {
    rm -rf "$TMPDIR"
}

trap cleanup EXIT

# ============================================================================
# Root check
# ============================================================================

if [[ $EUID -ne 0 ]]; then
    abort "This script must be run as root."
fi

# ============================================================================
# Detect operating system
# ============================================================================

APT="$(command -v apt 2>/dev/null || true)"
DNF="$(command -v dnf 2>/dev/null || true)"
YUM="$(command -v yum 2>/dev/null || true)"

if [[ -n "$APT" ]]; then
    OS="DEBIAN"

    log_info "Detected Debian/Ubuntu"

elif [[ -n "$DNF" || -n "$YUM" ]]; then
    OS="RHEL"

    log_info "Detected RHEL/Fedora"

else
    abort "Couldn't determine the current operating system."
fi

# ============================================================================
# Install/check dependencies
# ============================================================================

install_package() {
    local package="$1"

    if [[ "$OS" == "DEBIAN" ]]; then

        log_info "Installing ${package}"
        apt-get update -qq
        apt-get install -y "$package"

    else

        if [[ -n "$DNF" ]]; then
            log_info "Installing ${package}"
            dnf install -y "$package"
        else
            log_info "Installing ${package}"
            yum install -y "$package"
        fi

    fi
}

# ----------------------------------------------------------------------------
# firewalld
# ----------------------------------------------------------------------------

if ! command -v firewall-cmd >/dev/null 2>&1; then

    log_info "firewalld is not installed"

    install_package firewalld

    systemctl enable --now firewalld

else

    log_ok "firewalld is installed"

fi

# ----------------------------------------------------------------------------
# curl
# ----------------------------------------------------------------------------

if ! command -v curl >/dev/null 2>&1; then
    install_package curl
fi

if ! command -v curl >/dev/null 2>&1; then
    abort "curl is required but could not be installed."
fi

# ----------------------------------------------------------------------------
# bgpq4
# ----------------------------------------------------------------------------

if ! command -v bgpq4 >/dev/null 2>&1; then

    log_info "bgpq4 is not installed"

    install_package bgpq4

fi

if ! command -v bgpq4 >/dev/null 2>&1; then

    abort "bgpq4 is required for ASN prefix generation."
fi

log_ok "bgpq4 is available"

# ============================================================================
# Start firewalld
# ============================================================================

if ! systemctl is-active --quiet firewalld; then

    log_info "Starting firewalld"

    systemctl enable --now firewalld

    if ! systemctl is-active --quiet firewalld; then
        abort "firewalld could not be started."
    fi

fi

# ============================================================================
# Prepare temporary directory
# ============================================================================

rm -rf "$TMPDIR"

mkdir -p "$TMPDIR"

if [[ ! -d "$TMPDIR" ]]; then
    abort "Couldn't create ${TMPDIR}"
fi

# ============================================================================
# Download GeoIP lists
# ============================================================================

log_info "Retrieving requested GeoIP zones"

for zone in $ZONES; do

    log_info "Downloading IPv4 zone ${YELLOW}${zone}${NC}"

    IPV4_FILE="$TMPDIR/${zone}-ip4.zone"

    if ! curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --connect-timeout 30 \
        --max-time 120 \
        -o "$IPV4_FILE" \
        "https://www.ipdeny.com/ipblocks/data/aggregated/${zone,,}-aggregated.zone"
    then
        abort "Failed to download IPv4 zone ${zone}"
    fi

    if [[ ! -s "$IPV4_FILE" ]]; then
        abort "Downloaded IPv4 zone ${zone} is empty"
    fi

    log_ok "IPv4 ${zone} downloaded"

    log_info "Downloading IPv6 zone ${YELLOW}${zone}${NC}"

    IPV6_FILE="$TMPDIR/${zone}-ip6.zone"

    if ! curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --connect-timeout 30 \
        --max-time 120 \
        -o "$IPV6_FILE" \
        "https://www.ipdeny.com/ipv6/ipaddresses/aggregated/${zone,,}-aggregated.zone"
    then
        abort "Failed to download IPv6 zone ${zone}"
    fi

    if [[ ! -s "$IPV6_FILE" ]]; then
        abort "Downloaded IPv6 zone ${zone} is empty"
    fi

    log_ok "IPv6 ${zone} downloaded"

done

# ============================================================================
# Download ASN list
# ============================================================================

log_info "Downloading bad ASN list"

ASN_LIST_FILE="$TMPDIR/bad-asns.txt"

if ! curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --connect-timeout 30 \
    --max-time 120 \
    -o "$ASN_LIST_FILE" \
    "$ASN_LIST_URL"
then
    abort "Failed to download bad ASN list."
fi

if [[ ! -s "$ASN_LIST_FILE" ]]; then
    abort "Downloaded ASN list is empty."
fi

ASN_COUNT=$(grep -E '^AS[0-9]+' "$ASN_LIST_FILE" | wc -l)

if [[ "$ASN_COUNT" -lt 1 ]]; then
    abort "No valid ASNs were found in the downloaded ASN list."
fi

log_ok "Downloaded ${ASN_COUNT} blocked ASNs"

# ============================================================================
# Extract ASN objects
# ============================================================================

ASN_OBJECTS_FILE="$TMPDIR/asn-objects.txt"

grep -E '^AS[0-9]+' "$ASN_LIST_FILE" \
    | grep -oE '^AS[0-9]+' \
    | sort -u \
    > "$ASN_OBJECTS_FILE"

ASN_OBJECT_COUNT=$(wc -l < "$ASN_OBJECTS_FILE")

if [[ "$ASN_OBJECT_COUNT" -lt 1 ]]; then
    abort "No ASN objects were extracted."
fi

log_ok "Prepared ${ASN_OBJECT_COUNT} unique ASN objects"

# ============================================================================
# Generate ASN IPv4 prefixes
# ============================================================================

log_info "Generating IPv4 prefixes from blocked ASNs"
log_info "This may take some time because bgpq4 is querying IRR routing data."

ASN_IP4_FILE="$TMPDIR/asn-ip4.zone"

mapfile -t ASN_OBJECTS < "$ASN_OBJECTS_FILE"

if ! bgpq4 \
    -4 \
    -A \
    -F '%n/%l\n' \
    "${ASN_OBJECTS[@]}" \
    > "$ASN_IP4_FILE"
then
    abort "bgpq4 failed while generating IPv4 ASN prefixes."
fi

# Remove accidental blank lines.
sed -i '/^[[:space:]]*$/d' "$ASN_IP4_FILE"

ASN_IP4_COUNT=$(wc -l < "$ASN_IP4_FILE")

if [[ "$ASN_IP4_COUNT" -lt 1 ]]; then
    abort "bgpq4 produced no IPv4 prefixes."
fi

log_ok "Generated ${ASN_IP4_COUNT} IPv4 ASN prefixes"

# ============================================================================
# Generate ASN IPv6 prefixes
# ============================================================================

log_info "Generating IPv6 prefixes from blocked ASNs"

ASN_IP6_FILE="$TMPDIR/asn-ip6.zone"

if ! bgpq4 \
    -6 \
    -A \
    -F '%n/%l\n' \
    "${ASN_OBJECTS[@]}" \
    > "$ASN_IP6_FILE"
then
    abort "bgpq4 failed while generating IPv6 ASN prefixes."
fi

sed -i '/^[[:space:]]*$/d' "$ASN_IP6_FILE"

ASN_IP6_COUNT=$(wc -l < "$ASN_IP6_FILE")

if [[ "$ASN_IP6_COUNT" -lt 1 ]]; then
    abort "bgpq4 produced no IPv6 prefixes."
fi

log_ok "Generated ${ASN_IP6_COUNT} IPv6 ASN prefixes"

# ============================================================================
# Validate generated ASN lists
# ============================================================================

if ! grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]+$' "$ASN_IP4_FILE"; then
    abort "Generated IPv4 ASN list does not contain valid IPv4 CIDRs."
fi

if ! grep -Eq ':' "$ASN_IP6_FILE"; then
    abort "Generated IPv6 ASN list does not contain valid IPv6 prefixes."
fi

# ============================================================================
# Create GeoIP ipsets if required
# ============================================================================

create_ipset_if_missing() {

    local name="$1"
    local family="$2"

    if firewall-cmd --permanent --get-ipsets \
        | tr ' ' '\n' \
        | grep -Fxq "$name"
    then

        log_ok "ipset ${name} already exists"

        return 0
    fi

    log_info "Creating ipset ${name}"

    if ! firewall-cmd \
        --permanent \
        --new-ipset="$name" \
        --type=hash:net \
        --option="family=${family}" \
        --option="hashsize=${HASHSIZE}" \
        --option="maxelem=${MAXELEM}"
    then
        abort "Couldn't create ipset ${name}"
    fi

    log_ok "Created ${name}"
}

create_ipset_if_missing "$GEOIP_BLACKLIST_IP4" "inet"
create_ipset_if_missing "$GEOIP_BLACKLIST_IP6" "inet6"

# ============================================================================
# Build new ASN ipsets
#
# We use temporary/versioned ipsets so a failed update does not destroy
# the existing ASN blacklist.
# ============================================================================

TIMESTAMP="$(date +%Y%m%d%H%M%S)"

NEW_ASN_IP4="${ASN_BLACKLIST_IP4}-${TIMESTAMP}"
NEW_ASN_IP6="${ASN_BLACKLIST_IP6}-${TIMESTAMP}"

log_info "Creating temporary ASN IPv4 ipset ${NEW_ASN_IP4}"

if ! firewall-cmd \
    --permanent \
    --new-ipset="$NEW_ASN_IP4" \
    --type=hash:net \
    --option=family=inet \
    --option="hashsize=${HASHSIZE}" \
    --option="maxelem=${MAXELEM}"
then
    abort "Couldn't create temporary ASN IPv4 ipset."
fi

log_info "Loading ASN IPv4 prefixes"

if ! firewall-cmd \
    --permanent \
    --ipset="$NEW_ASN_IP4" \
    --add-entries-from-file="$ASN_IP4_FILE"
then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    abort "Couldn't load ASN IPv4 prefixes."
fi

log_ok "Loaded ASN IPv4 prefixes"

log_info "Creating temporary ASN IPv6 ipset ${NEW_ASN_IP6}"

if ! firewall-cmd \
    --permanent \
    --new-ipset="$NEW_ASN_IP6" \
    --type=hash:net \
    --option=family=inet6 \
    --option="hashsize=${HASHSIZE}" \
    --option="maxelem=${MAXELEM}"
then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    abort "Couldn't create temporary ASN IPv6 ipset."
fi

log_info "Loading ASN IPv6 prefixes"

if ! firewall-cmd \
    --permanent \
    --ipset="$NEW_ASN_IP6" \
    --add-entries-from-file="$ASN_IP6_FILE"
then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP6" >/dev/null 2>&1
    abort "Couldn't load ASN IPv6 prefixes."
fi

log_ok "Loaded ASN IPv6 prefixes"

# ============================================================================
# Validate temporary ASN ipsets
# ============================================================================

LOADED_ASN_IP4_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$NEW_ASN_IP4" \
        --get-entries \
        | wc -l
)

LOADED_ASN_IP6_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$NEW_ASN_IP6" \
        --get-entries \
        | wc -l
)

if [[ "$LOADED_ASN_IP4_COUNT" -lt 1 ]]; then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP6" >/dev/null 2>&1

    abort "Temporary ASN IPv4 ipset contains no entries."
fi

if [[ "$LOADED_ASN_IP6_COUNT" -lt 1 ]]; then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP6" >/dev/null 2>&1

    abort "Temporary ASN IPv6 ipset contains no entries."
fi

log_ok "ASN IPv4 ipset contains ${LOADED_ASN_IP4_COUNT} entries"
log_ok "ASN IPv6 ipset contains ${LOADED_ASN_IP6_COUNT} entries"

# ============================================================================
# Attach GeoIP sets to drop zone
# ============================================================================

log_info "Ensuring GeoIP ipsets are attached to drop zone"

firewall-cmd \
    --permanent \
    --zone=drop \
    --add-source="ipset:${GEOIP_BLACKLIST_IP4}" \
    >/dev/null 2>&1 || true

firewall-cmd \
    --permanent \
    --zone=drop \
    --add-source="ipset:${GEOIP_BLACKLIST_IP6}" \
    >/dev/null 2>&1 || true

# ============================================================================
# Attach new ASN sets BEFORE removing old ones.
#
# This means that during an update the firewall can temporarily contain
# both old and new ASN sets, which is safer than having an empty window.
# ============================================================================

log_info "Attaching new ASN ipsets to drop zone"

if ! firewall-cmd \
    --permanent \
    --zone=drop \
    --add-source="ipset:${NEW_ASN_IP4}"
then
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP6" >/dev/null 2>&1

    abort "Couldn't attach new ASN IPv4 ipset."
fi

if ! firewall-cmd \
    --permanent \
    --zone=drop \
    --add-source="ipset:${NEW_ASN_IP6}"
then
    firewall-cmd \
        --permanent \
        --zone=drop \
        --remove-source="ipset:${NEW_ASN_IP4}" \
        >/dev/null 2>&1

    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP4" >/dev/null 2>&1
    firewall-cmd --permanent --delete-ipset="$NEW_ASN_IP6" >/dev/null 2>&1

    abort "Couldn't attach new ASN IPv6 ipset."
fi

# ============================================================================
# Find existing ASN ipsets
# ============================================================================

OLD_ASN_IP4=""
OLD_ASN_IP6=""

for existing in $(firewall-cmd --permanent --get-ipsets); do

    if [[ "$existing" == "${ASN_BLACKLIST_IP4}-"* ]]; then
        OLD_ASN_IP4="$existing"
    fi

    if [[ "$existing" == "${ASN_BLACKLIST_IP6}-"* ]]; then
        OLD_ASN_IP6="$existing"
    fi

done

# ============================================================================
# Reload with old + new ASN sets attached.
# ============================================================================

log_info "Reloading firewalld with new ASN lists"

if ! firewall-cmd --reload >/dev/null; then

    log_error "firewalld reload failed."

    # Remove new sources from permanent configuration.
    firewall-cmd \
        --permanent \
        --zone=drop \
        --remove-source="ipset:${NEW_ASN_IP4}" \
        >/dev/null 2>&1 || true

    firewall-cmd \
        --permanent \
        --zone=drop \
        --remove-source="ipset:${NEW_ASN_IP6}" \
        >/dev/null 2>&1 || true

    firewall-cmd \
        --permanent \
        --delete-ipset="$NEW_ASN_IP4" \
        >/dev/null 2>&1 || true

    firewall-cmd \
        --permanent \
        --delete-ipset="$NEW_ASN_IP6" \
        >/dev/null 2>&1 || true

    abort "ASN update was not activated."
fi

log_ok "New ASN lists are active"

# ============================================================================
# Remove old ASN sources
# ============================================================================

if [[ -n "$OLD_ASN_IP4" && "$OLD_ASN_IP4" != "$NEW_ASN_IP4" ]]; then

    log_info "Removing old ASN IPv4 ipset ${OLD_ASN_IP4}"

    firewall-cmd \
        --permanent \
        --zone=drop \
        --remove-source="ipset:${OLD_ASN_IP4}" \
        >/dev/null 2>&1 || true

fi

if [[ -n "$OLD_ASN_IP6" && "$OLD_ASN_IP6" != "$NEW_ASN_IP6" ]]; then

    log_info "Removing old ASN IPv6 ipset ${OLD_ASN_IP6}"

    firewall-cmd \
        --permanent \
        --zone=drop \
        --remove-source="ipset:${OLD_ASN_IP6}" \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# Reload after removing old sources
# ============================================================================

log_info "Reloading firewalld"

if ! firewall-cmd --reload >/dev/null; then

    log_warn "Second firewalld reload failed."
    log_warn "The new ASN lists are still present and the old sources may also remain."
    log_warn "Run the script again after investigating firewalld."

else

    log_ok "Old ASN sources removed"

fi

# ============================================================================
# Delete old ASN ipsets
# ============================================================================

if [[ -n "$OLD_ASN_IP4" && "$OLD_ASN_IP4" != "$NEW_ASN_IP4" ]]; then

    firewall-cmd \
        --permanent \
        --delete-ipset="$OLD_ASN_IP4" \
        >/dev/null 2>&1 || true

fi

if [[ -n "$OLD_ASN_IP6" && "$OLD_ASN_IP6" != "$NEW_ASN_IP6" ]]; then

    firewall-cmd \
        --permanent \
        --delete-ipset="$OLD_ASN_IP6" \
        >/dev/null 2>&1 || true

fi

# ============================================================================
# Final verification
# ============================================================================

log_info "Final firewall verification"

firewall-cmd --permanent --zone=drop --list-sources

echo ""

FINAL_GEOIP_IP4_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$GEOIP_BLACKLIST_IP4" \
        --get-entries \
        | wc -l
)

FINAL_GEOIP_IP6_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$GEOIP_BLACKLIST_IP6" \
        --get-entries \
        | wc -l
)

FINAL_ASN_IP4_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$NEW_ASN_IP4" \
        --get-entries \
        | wc -l
)

FINAL_ASN_IP6_COUNT=$(
    firewall-cmd \
        --permanent \
        --ipset="$NEW_ASN_IP6" \
        --get-entries \
        | wc -l
)

echo -e "[${PURPLE}i${NC}] GeoIP IPv4 ranges:       ${YELLOW}${FINAL_GEOIP_IP4_COUNT}${NC}"
echo -e "[${PURPLE}i${NC}] GeoIP IPv6 ranges:       ${YELLOW}${FINAL_GEOIP_IP6_COUNT}${NC}"
echo -e "[${PURPLE}i${NC}] ASN IPv4 ranges:          ${YELLOW}${FINAL_ASN_IP4_COUNT}${NC}"
echo -e "[${PURPLE}i${NC}] ASN IPv6 ranges:          ${YELLOW}${FINAL_ASN_IP6_COUNT}${NC}"
echo -e "[${PURPLE}i${NC}] Blocked ASNs processed:   ${YELLOW}${ASN_COUNT}${NC}"

echo ""

log_ok "Firewall successfully configured with GeoIP + ASN blocking!"
