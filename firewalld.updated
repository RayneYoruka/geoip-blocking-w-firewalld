#!/usr/bin/env bash

set -Eeuo pipefail

###############################################################################
# firewalld GeoIP + Bad ASN blacklist updater
#
# Requirements:
#   - firewalld
#   - curl
#   - bgpq4
#   - python3
#
# Data:
#   GeoIP IPv4 : IPdeny aggregated country lists
#   GeoIP IPv6 : IPdeny aggregated IPv6 country lists
#   Bad ASNs   : bountyyfi bad-asn-list
#   ASN routes : bgpq4 / IRR
#
# Strat:
#   - Generate everything in temporary/staged ipsets.
#   - Validate before touching stable configuration.
#   - Activate staged sets first.
#   - Size hash:net ipsets dynamically from validated entry counts.
#   - Activate stable sets.
#   - Remove staged sets only after stable sets are verified.
#
# IMPORTANT:
#   firewalld does NOT provide --rename-ipset.
#   Therefore this script promotes staged data by creating the stable
#   ipsets from the already validated files.
###############################################################################

############################
# Configuration
############################

ZONES="ru cn"

# Deduplicate country codes while preserving their configured order.
ZONES=$(printf '%s\n' ${ZONES} | awk '!seen[$0]++' | tr '\n' ' ' | sed 's/[[:space:]]*$//')

[[ -n "${ZONES}" ]] || die "No GeoIP countries configured."

ZONE="drop"

WORK_DIR="/var/lib/firewalld-geoip"

IPDENY_IP4_BASE="https://www.ipdeny.com/ipblocks/data/aggregated"
IPDENY_IP6_BASE="https://www.ipdeny.com/ipv6/ipaddresses/aggregated"

ASN_LIST_URL="https://raw.githubusercontent.com/bountyyfi/bad-asn-list/refs/heads/main/all.txt"

ASN_LIST="${WORK_DIR}/bad-asn.txt"
ASN_LIST_CLEAN="${ASN_LIST}.clean"

GEOIP_RAW="${WORK_DIR}/geoip-ip4.raw"
GEOIP_IP6_RAW="${WORK_DIR}/geoip-ip6.raw"
GEOIP_IP4_FILE="${WORK_DIR}/geoip-ip4.txt"
GEOIP_IP6_FILE="${WORK_DIR}/geoip-ip6.txt"

ASN_IP4_RAW="${WORK_DIR}/asn-ip4.raw"
ASN_IP6_RAW="${WORK_DIR}/asn-ip6.raw"
ASN_IP4_FILE="${WORK_DIR}/asn-ip4.txt"
ASN_IP6_FILE="${WORK_DIR}/asn-ip6.txt"

ASN_OBJECTS="${WORK_DIR}/asn-objects.txt"

############################
# Stable ipset names
############################

GEOIP_IP4="geoip-blacklist-ip4"
GEOIP_IP6="geoip-blacklist-ip6"

ASN_IP4="asn-blacklist-ip4"
ASN_IP6="asn-blacklist-ip6"

############################
# Staged ipset names
############################

NEW_GEOIP_IP4="${GEOIP_IP4}-new"
NEW_GEOIP_IP6="${GEOIP_IP6}-new"

NEW_ASN_IP4="${ASN_IP4}-new"
NEW_ASN_IP6="${ASN_IP6}-new"

############################
# Output helpers
############################

info()
{
    echo "[i] $*"
}

success()
{
    echo "[✓] $*"
}

error()
{
    echo "[✗] $*" >&2
}

die()
{
    error "$*"
    exit 1
}

############################
# Calculate ipset maxelem
############################

calculate_maxelem()
{
    local count="$1"
    local target
    local maxelem=65536

    # Keep 25% headroom above the current entry count.
    target=$(( count + count / 4 ))

    while (( maxelem < target )); do
        maxelem=$(( maxelem * 2 ))
    done

    echo "${maxelem}"
}

############################
# Firewalld ipset existence
#
# firewall-cmd --get-ipsets returns names separated by whitespace.
############################

ipset_exists_permanent()
{
    firewall-cmd --permanent --get-ipsets 2>/dev/null \
        | tr -s '[:space:]' '\n' \
        | grep -Fxq "$1"
}

ipset_exists_runtime()
{
    firewall-cmd --get-ipsets 2>/dev/null \
        | tr -s '[:space:]' '\n' \
        | grep -Fxq "$1"
}

############################
# Zone source existence
############################

zone_source_exists_permanent()
{
    firewall-cmd \
        --permanent \
        --zone="${ZONE}" \
        --list-sources 2>/dev/null \
        | tr -s '[:space:]' '\n' \
        | grep -Fxq "ipset:$1"
}

zone_source_exists_runtime()
{
    firewall-cmd \
        --zone="${ZONE}" \
        --list-sources 2>/dev/null \
        | tr -s '[:space:]' '\n' \
        | grep -Fxq "ipset:$1"
}

############################
# Remove permanent ipset
############################

remove_permanent_ipset()
{
    local name="$1"

    if ipset_exists_permanent "${name}"; then
        info "Removing permanent ipset ${name}..."

        firewall-cmd \
            --permanent \
            --delete-ipset="${name}" \
            >/dev/null
    fi
}

############################
# Remove permanent zone source
############################

remove_permanent_source()
{
    local name="$1"

    if zone_source_exists_permanent "${name}"; then

        firewall-cmd \
            --permanent \
            --zone="${ZONE}" \
            --remove-source="ipset:${name}" \
            >/dev/null

    fi
}

############################
# Remove runtime zone source
############################

remove_runtime_source()
{
    local name="$1"

    if zone_source_exists_runtime "${name}"; then

        firewall-cmd \
            --zone="${ZONE}" \
            --remove-source="ipset:${name}" \
            >/dev/null

    fi
}

############################
# Cleanup staged ipsets
############################

cleanup_staged()
{
    info "Cleaning stale staged ipsets..."

    for set in \
        "${NEW_GEOIP_IP4}" \
        "${NEW_GEOIP_IP6}" \
        "${NEW_ASN_IP4}" \
        "${NEW_ASN_IP6}"
    do

        remove_permanent_source "${set}"
        remove_permanent_ipset "${set}"

    done

    success "Stale staged ipset cleanup complete."
}

############################
# Configuration display
############################

echo
echo "============================================================"
echo " firewalld GeoIP + Bad ASN blacklist updater"
echo "============================================================"
echo

info "Configuration:"
echo "      Countries : ${ZONES}"
echo "      Zone      : ${ZONE}"
echo "      Work dir  : ${WORK_DIR}"
echo
echo "      GeoIP IPv4 : ${GEOIP_IP4}"
echo "      GeoIP IPv6 : ${GEOIP_IP6}"
echo "      ASN IPv4   : ${ASN_IP4}"
echo "      ASN IPv6   : ${ASN_IP6}"
echo
echo "      Staged:"
echo "      ${NEW_GEOIP_IP4}"
echo "      ${NEW_GEOIP_IP6}"
echo "      ${NEW_ASN_IP4}"
echo "      ${NEW_ASN_IP6}"
echo

############################
# Root check
############################

[[ "${EUID}" -eq 0 ]] \
    || die "This script must be run as root."

############################
# Dependencies
############################

for command in \
    firewall-cmd \
    curl \
    bgpq4 \
    python3
do

    command -v "${command}" >/dev/null 2>&1 \
        || die "Required command not found: ${command}"

done

############################
# Work directory
############################

mkdir -p "${WORK_DIR}"

############################
# Cleanup stale staged sets
############################

cleanup_staged

############################
# Check firewalld ipset support
############################

info "Checking Firewalld ipset support..."

firewall-cmd --get-ipset-types \
    | tr ' ' '\n' \
    | grep -Fxq "hash:net" \
    || die "Firewalld does not support hash:net ipsets."

success "Firewalld ipsets are supported."

###############################################################################
# GEOIP
###############################################################################

############################
# Download GeoIP lists
############################

info "Downloading GeoIP country lists..."

: > "${GEOIP_RAW}"
: > "${GEOIP_IP6_RAW}"

for country in ${ZONES}; do

    url="${IPDENY_IP4_BASE}/${country}-aggregated.zone"
    output="${WORK_DIR}/${country}-aggregated.zone"

    info "Downloading ${country} IPv4 ranges..."

    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 3 \
        --retry-delay 2 \
        --connect-timeout 15 \
        --max-time 120 \
        "${url}" \
        --output "${output}" \
        || die "Failed to download ${country} IPv4 GeoIP list."

    [[ -s "${output}" ]] \
        || die "Downloaded ${country} IPv4 GeoIP list is empty."

    cat "${output}" >> "${GEOIP_RAW}"

    url="${IPDENY_IP6_BASE}/${country}-aggregated.zone"
    output="${WORK_DIR}/${country}-aggregated-ipv6.zone"

    info "Downloading ${country} IPv6 ranges..."

    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 3 \
        --retry-delay 2 \
        --connect-timeout 15 \
        --max-time 120 \
        "${url}" \
        --output "${output}" \
        || die "Failed to download ${country} IPv6 GeoIP list."

    [[ -s "${output}" ]] \
        || die "Downloaded ${country} IPv6 GeoIP list is empty."

    cat "${output}" >> "${GEOIP_IP6_RAW}"

done

success "GeoIP IPv4 and IPv6 country lists downloaded."

############################
# Normalize GeoIP IPv4
############################

info "Normalizing GeoIP IPv4 prefixes..."

python3 - "${GEOIP_RAW}" "${GEOIP_IP4_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:
    for line in f:
        value = line.strip()
        if not value:
            continue
        try:
            net = ipaddress.ip_network(value, strict=False)
        except ValueError:
            raise SystemExit(f"Invalid CIDR in {src}: {value}")
        if net.version == 4:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:
    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv4 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

GEOIP_COUNT=$(wc -l < "${GEOIP_IP4_FILE}")

[[ "${GEOIP_COUNT}" -gt 0 ]] \
    || die "Normalized GeoIP IPv4 list is empty."

success "GeoIP IPv4: ${GEOIP_COUNT} normalized networks."

############################
# Normalize GeoIP IPv6
############################

info "Normalizing GeoIP IPv6 prefixes..."

python3 - "${GEOIP_IP6_RAW}" "${GEOIP_IP6_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:
    for line in f:
        value = line.strip()
        if not value:
            continue
        try:
            net = ipaddress.ip_network(value, strict=False)
        except ValueError:
            raise SystemExit(f"Invalid CIDR in {src}: {value}")
        if net.version == 6:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:
    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv6 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

GEOIP_IP6_COUNT=$(wc -l < "${GEOIP_IP6_FILE}")

[[ "${GEOIP_IP6_COUNT}" -gt 0 ]] \
    || die "Normalized GeoIP IPv6 list is empty."

success "GeoIP IPv6: ${GEOIP_IP6_COUNT} normalized networks."

############################
# Download bad ASN list
############################



curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --retry 3 \
    --retry-delay 2 \
    --connect-timeout 15 \
    --max-time 120 \
    "${ASN_LIST_URL}" \
    --output "${ASN_LIST}" \
    || die "Failed to download bad ASN list."

[[ -s "${ASN_LIST}" ]] \
    || die "Downloaded bad ASN list is empty."

success "Bad ASN list downloaded."

############################
# Parse ASN list
############################

info "Parsing bad ASN list..."

awk '
{
    asn = $1
    sub(/^AS/, "", asn)

    if (asn ~ /^[0-9]+$/)
        print asn
}
' "${ASN_LIST}" \
    | sort -n -u \
    > "${ASN_LIST_CLEAN}"

ASN_COUNT=$(wc -l < "${ASN_LIST_CLEAN}")

[[ "${ASN_COUNT}" -gt 0 ]] \
    || die "No valid ASNs were found."

success "Bad ASN list: ${ASN_COUNT} unique ASNs."

############################
# Prepare bgpq4 objects
############################

info "Preparing ${ASN_COUNT} ASN objects for bgpq4..."

awk '{ print "AS" $1 }' \
    "${ASN_LIST_CLEAN}" \
    > "${ASN_OBJECTS}"

OBJECT_COUNT=$(wc -l < "${ASN_OBJECTS}")

[[ "${OBJECT_COUNT}" -eq "${ASN_COUNT}" ]] \
    || die "ASN object count does not match ASN count."

success "Prepared ${OBJECT_COUNT} ASN objects."

###############################################################################
# ASN PREFIX GENERATION
###############################################################################

############################
# Generate ASN IPv4
#
# bgpq4 1.16:
#   -F fmt allows us to request raw CIDR output.
############################

info "Generating ASN IPv4 prefixes with bgpq4..."
info "Querying ${ASN_COUNT} ASNs in a single bgpq4 operation..."

bgpq4 \
    -4 \
    -F '%n/%l\n' \
    $(cat "${ASN_OBJECTS}") \
    > "${ASN_IP4_RAW}" \
    || die "bgpq4 IPv4 query failed."

ASN_IP4_RAW_COUNT=$(wc -l < "${ASN_IP4_RAW}")

[[ "${ASN_IP4_RAW_COUNT}" -gt 0 ]] \
    || die "bgpq4 returned no IPv4 prefixes."

success "ASN IPv4 raw prefixes: ${ASN_IP4_RAW_COUNT}"

############################
# Generate ASN IPv6
############################

info "Generating ASN IPv6 prefixes with bgpq4..."
info "Querying ${ASN_COUNT} ASNs in a single bgpq4 operation..."

bgpq4 \
    -6 \
    -F '%n/%l\n' \
    $(cat "${ASN_OBJECTS}") \
    > "${ASN_IP6_RAW}" \
    || die "bgpq4 IPv6 query failed."

ASN_IP6_RAW_COUNT=$(wc -l < "${ASN_IP6_RAW}")

[[ "${ASN_IP6_RAW_COUNT}" -gt 0 ]] \
    || die "bgpq4 returned no IPv6 prefixes."

success "ASN IPv6 raw prefixes: ${ASN_IP6_RAW_COUNT}"

############################
# Validate raw bgpq4 output
############################

info "Validating raw bgpq4 CIDR output..."

python3 - \
    "${ASN_IP4_RAW}" \
    "${ASN_IP6_RAW}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:

    count = 0

    with open(filename, "r", encoding="utf-8") as f:

        for lineno, line in enumerate(f, 1):

            value = line.strip()

            if not value:
                continue

            try:
                ipaddress.ip_network(value, strict=False)
            except ValueError:
                print(
                    f"Invalid bgpq4 output in "
                    f"{filename}:{lineno}: {value}",
                    file=sys.stderr
                )
                sys.exit(1)

            count += 1

    print(f"{filename}: {count} valid CIDRs.")

print("Raw bgpq4 output validation passed.")
PY

success "Raw bgpq4 output validation passed."

############################
# Normalize ASN IPv4
############################

info "Normalizing ASN IPv4 prefixes..."

python3 - "${ASN_IP4_RAW}" "${ASN_IP4_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:

    for line in f:

        value = line.strip()

        if not value:
            continue

        net = ipaddress.ip_network(value, strict=False)

        if net.version == 4:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:

    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv4 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

ASN_IP4_COUNT=$(wc -l < "${ASN_IP4_FILE}")

[[ "${ASN_IP4_COUNT}" -gt 0 ]] \
    || die "Normalized ASN IPv4 list is empty."

success "ASN IPv4: ${ASN_IP4_COUNT} normalized networks."

############################
# Normalize ASN IPv6
############################

info "Normalizing ASN IPv6 prefixes..."

python3 - "${ASN_IP6_RAW}" "${ASN_IP6_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:

    for line in f:

        value = line.strip()

        if not value:
            continue

        net = ipaddress.ip_network(value, strict=False)

        if net.version == 6:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:

    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv6 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

ASN_IP6_COUNT=$(wc -l < "${ASN_IP6_FILE}")

[[ "${ASN_IP6_COUNT}" -gt 0 ]] \
    || die "Normalized ASN IPv6 list is empty."

success "ASN IPv6: ${ASN_IP6_COUNT} normalized networks."

############################
# Calculate ipset capacities
############################

info "Calculating ipset capacities..."

GEOIP_IP4_MAXELEM=$(calculate_maxelem "${GEOIP_COUNT}")
GEOIP_IP6_MAXELEM=$(calculate_maxelem "${GEOIP_IP6_COUNT}")
ASN_IP4_MAXELEM=$(calculate_maxelem "${ASN_IP4_COUNT}")
ASN_IP6_MAXELEM=$(calculate_maxelem "${ASN_IP6_COUNT}")

echo
echo "      Calculated ipset capacities:"
echo "      GeoIP IPv4 : ${GEOIP_COUNT} entries -> maxelem ${GEOIP_IP4_MAXELEM}"
echo "      GeoIP IPv6 : ${GEOIP_IP6_COUNT} entries -> maxelem ${GEOIP_IP6_MAXELEM}"
echo "      ASN IPv4   : ${ASN_IP4_COUNT} entries -> maxelem ${ASN_IP4_MAXELEM}"
echo "      ASN IPv6   : ${ASN_IP6_COUNT} entries -> maxelem ${ASN_IP6_MAXELEM}"
echo

###############################################################################
# VALIDATION
###############################################################################

############################
# Validate generated CIDRs
############################

info "Validating generated CIDR lists..."

python3 - \
    "${GEOIP_IP4_FILE}" \
    "${GEOIP_IP6_FILE}" \
    "${ASN_IP4_FILE}" \
    "${ASN_IP6_FILE}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:

    with open(filename, "r", encoding="utf-8") as f:

        for lineno, line in enumerate(f, 1):

            value = line.strip()

            if not value:
                continue

            try:
                ipaddress.ip_network(value, strict=False)
            except ValueError as exc:
                print(
                    f"Invalid CIDR in "
                    f"{filename}:{lineno}: "
                    f"{value}: {exc}",
                    file=sys.stderr
                )
                sys.exit(1)

print("CIDR validation passed.")
PY

success "CIDR validation passed."

############################
# Reject default routes
############################

info "Checking for default routes in ASN lists..."

python3 - \
    "${ASN_IP4_FILE}" \
    "${ASN_IP6_FILE}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:

    with open(filename, "r", encoding="utf-8") as f:

        for line in f:

            value = line.strip()

            if not value:
                continue

            net = ipaddress.ip_network(value, strict=False)

            if net.prefixlen == 0:

                print(
                    f"ERROR: default route found "
                    f"in {filename}: {net}",
                    file=sys.stderr
                )

                sys.exit(1)

print("No IPv4/IPv6 default routes found.")
PY

success "No default routes found."

############################
# Check ASN overlaps
############################

info "Checking ASN lists for overlapping networks..."

python3 - \
    "${ASN_IP4_FILE}" \
    "${ASN_IP6_FILE}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:

    networks = []

    with open(filename, "r", encoding="utf-8") as f:

        for line in f:

            value = line.strip()

            if not value:
                continue

            networks.append(
                ipaddress.ip_network(value, strict=False)
            )

    networks.sort(
        key=lambda n: (
            int(n.network_address),
            n.prefixlen
        )
    )

    previous = None

    for net in networks:

        if previous is not None and net.overlaps(previous):

            print(
                f"ERROR: overlapping ASN networks "
                f"in {filename}: "
                f"{previous} overlaps {net}",
                file=sys.stderr
            )

            sys.exit(1)

        previous = net

print("No overlapping ASN networks found.")
PY

success "No overlapping ASN networks found."

###############################################################################
# FIREWALLD STAGING
###############################################################################

############################
# hash:net support
############################

info "Checking Firewalld hash:net ipset support..."

HASH_TEST_V4="firewalld-hash-net-test-v4"
HASH_TEST_V6="firewalld-hash-net-test-v6"

remove_permanent_ipset "${HASH_TEST_V4}"
remove_permanent_ipset "${HASH_TEST_V6}"

firewall-cmd \
    --permanent \
    --new-ipset="${HASH_TEST_V4}" \
    --type=hash:net \
    >/dev/null

firewall-cmd \
    --permanent \
    --new-ipset="${HASH_TEST_V6}" \
    --type=hash:net \
    --family=inet6 \
    >/dev/null

firewall-cmd \
    --permanent \
    --delete-ipset="${HASH_TEST_V4}" \
    >/dev/null

firewall-cmd \
    --permanent \
    --delete-ipset="${HASH_TEST_V6}" \
    >/dev/null

success "hash:net ipsets are supported."

###############################################################################
# CREATE STAGED SETS
###############################################################################

info "Creating staged blacklist ipsets..."

############################
# GeoIP IPv4
############################

info "Creating IPv4 temporary ipset ${NEW_GEOIP_IP4}..."

firewall-cmd \
    --permanent \
    --new-ipset="${NEW_GEOIP_IP4}" \
    --type=hash:net \
    --option="maxelem=${GEOIP_IP4_MAXELEM}" \
    >/dev/null

info "Loading IPv4 entries into ${NEW_GEOIP_IP4}..."

firewall-cmd \
    --permanent \
    --ipset="${NEW_GEOIP_IP4}" \
    --add-entries-from-file="${GEOIP_IP4_FILE}" \
    >/dev/null

success "Staged GeoIP IPv4 loaded."

############################
# GeoIP IPv6
############################

info "Creating IPv6 temporary ipset ${NEW_GEOIP_IP6}..."

firewall-cmd \
    --permanent \
    --new-ipset="${NEW_GEOIP_IP6}" \
    --type=hash:net \
    --family=inet6 \
    --option="maxelem=${GEOIP_IP6_MAXELEM}" \
    >/dev/null

if [[ -s "${GEOIP_IP6_FILE}" ]]; then

    info "Loading IPv6 entries into ${NEW_GEOIP_IP6}..."

    firewall-cmd \
        --permanent \
        --ipset="${NEW_GEOIP_IP6}" \
        --add-entries-from-file="${GEOIP_IP6_FILE}" \
        >/dev/null

    success "Staged GeoIP IPv6 loaded."

else

    info "${NEW_GEOIP_IP6} has no entries."

    success "Staged GeoIP IPv6 loaded as empty."

fi

############################
# ASN IPv4
############################

info "Creating IPv4 temporary ipset ${NEW_ASN_IP4}..."

firewall-cmd \
    --permanent \
    --new-ipset="${NEW_ASN_IP4}" \
    --type=hash:net \
    --option="maxelem=${ASN_IP4_MAXELEM}" \
    >/dev/null

info "Loading IPv4 entries into ${NEW_ASN_IP4}..."

firewall-cmd \
    --permanent \
    --ipset="${NEW_ASN_IP4}" \
    --add-entries-from-file="${ASN_IP4_FILE}" \
    >/dev/null

success "Staged ASN IPv4 loaded."

############################
# ASN IPv6
############################

info "Creating IPv6 temporary ipset ${NEW_ASN_IP6}..."

firewall-cmd \
    --permanent \
    --new-ipset="${NEW_ASN_IP6}" \
    --type=hash:net \
    --family=inet6 \
    --option="maxelem=${ASN_IP6_MAXELEM}" \
    >/dev/null

info "Loading IPv6 entries into ${NEW_ASN_IP6}..."

firewall-cmd \
    --permanent \
    --ipset="${NEW_ASN_IP6}" \
    --add-entries-from-file="${ASN_IP6_FILE}" \
    >/dev/null

success "Staged ASN IPv6 loaded."

###############################################################################
# VERIFY STAGED SETS
###############################################################################

info "Verifying staged ipsets in permanent configuration..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    ipset_exists_permanent "${set}" \
        || die "Staged ipset ${set} was not created in permanent configuration."

done

success "All staged ipsets exist in permanent configuration."

############################
# Verify staged contents
############################

info "Verifying staged ipset contents..."

verify_ipset_entries()
{
    local set="$1"
    local expected_file="$2"

    local expected
    local actual

    expected=$(
        grep -cve '^[[:space:]]*$' "${expected_file}" || true
    )

    actual=$(
        firewall-cmd \
            --permanent \
            --ipset="${set}" \
            --get-entries \
            | tr ' ' '\n' \
            | sed '/^[[:space:]]*$/d' \
            | wc -l
    )

    if [[ "${expected}" -ne "${actual}" ]]; then

        die \
            "Entry count mismatch for ${set}: " \
            "expected ${expected}, got ${actual}."

    fi

    info "${set}: ${actual} entries verified."
}

verify_ipset_entries \
    "${NEW_GEOIP_IP4}" \
    "${GEOIP_IP4_FILE}"

verify_ipset_entries \
    "${NEW_GEOIP_IP6}" \
    "${GEOIP_IP6_FILE}"

verify_ipset_entries \
    "${NEW_ASN_IP4}" \
    "${ASN_IP4_FILE}"

verify_ipset_entries \
    "${NEW_ASN_IP6}" \
    "${ASN_IP6_FILE}"

success "All staged ipset contents verified."

###############################################################################
# ACTIVATE STAGED SETS
###############################################################################

info "Verifying existing ${ZONE} zone..."

firewall-cmd \
    --permanent \
    --zone="${ZONE}" \
    --list-sources \
    >/dev/null \
    || die "Unable to access permanent zone ${ZONE}."

success "Zone ${ZONE} is available."

############################
# Attach staged sources
############################

info "Attaching staged ipsets to ${ZONE}..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    if ! zone_source_exists_permanent "${set}"; then

        firewall-cmd \
            --permanent \
            --zone="${ZONE}" \
            --add-source="ipset:${set}" \
            >/dev/null

    fi

done

success "Staged ipsets attached to ${ZONE}."

############################
# First reload
############################

info "Reloading firewalld with staged blacklists..."

firewall-cmd --reload >/dev/null

success "Firewalld reloaded."

############################
# Runtime verification
############################

info "Verifying staged ipsets in runtime configuration..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    ipset_exists_runtime "${set}" \
        || die "Staged ipset ${set} was not loaded into runtime configuration."

done

success "All staged ipsets are active at runtime."

############################
# Runtime source verification
############################

info "Verifying staged zone sources at runtime..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    zone_source_exists_runtime "${set}" \
        || die "Runtime zone ${ZONE} is missing source ipset:${set}."

done

success "All staged zone sources are active at runtime."

###############################################################################
# STABLE SET PROMOTION
#
# No --rename-ipset exists in this firewalld.
#
# The staged sets remain active while we construct the stable sets.
###############################################################################

info "Promoting staged data into stable ipsets..."

############################
# Remove old stable sources
############################

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    remove_permanent_source "${set}"

done

############################
# Remove old stable ipsets
#
# IMPORTANT:
# staged sets are still attached and active.
############################

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    remove_permanent_ipset "${set}"

done

############################
# Create stable GeoIP IPv4
############################

info "Creating stable ipset ${GEOIP_IP4}..."

firewall-cmd \
    --permanent \
    --new-ipset="${GEOIP_IP4}" \
    --type=hash:net \
    --option="maxelem=${GEOIP_IP4_MAXELEM}" \
    >/dev/null

info "Loading ${GEOIP_IP4}..."

firewall-cmd \
    --permanent \
    --ipset="${GEOIP_IP4}" \
    --add-entries-from-file="${GEOIP_IP4_FILE}" \
    >/dev/null

############################
# Create stable GeoIP IPv6
############################

info "Creating stable ipset ${GEOIP_IP6}..."

firewall-cmd \
    --permanent \
    --new-ipset="${GEOIP_IP6}" \
    --type=hash:net \
    --family=inet6 \
    --option="maxelem=${GEOIP_IP6_MAXELEM}" \
    >/dev/null

if [[ -s "${GEOIP_IP6_FILE}" ]]; then

    info "Loading ${GEOIP_IP6}..."

    firewall-cmd \
        --permanent \
        --ipset="${GEOIP_IP6}" \
        --add-entries-from-file="${GEOIP_IP6_FILE}" \
        >/dev/null

fi

############################
# Create stable ASN IPv4
############################

info "Creating stable ipset ${ASN_IP4}..."

firewall-cmd \
    --permanent \
    --new-ipset="${ASN_IP4}" \
    --type=hash:net \
    --option="maxelem=${ASN_IP4_MAXELEM}" \
    >/dev/null

info "Loading ${ASN_IP4}..."

firewall-cmd \
    --permanent \
    --ipset="${ASN_IP4}" \
    --add-entries-from-file="${ASN_IP4_FILE}" \
    >/dev/null

############################
# Create stable ASN IPv6
############################

info "Creating stable ipset ${ASN_IP6}..."

firewall-cmd \
    --permanent \
    --new-ipset="${ASN_IP6}" \
    --type=hash:net \
    --family=inet6 \
    --option="maxelem=${ASN_IP6_MAXELEM}" \
    >/dev/null

info "Loading ${ASN_IP6}..."

firewall-cmd \
    --permanent \
    --ipset="${ASN_IP6}" \
    --add-entries-from-file="${ASN_IP6_FILE}" \
    >/dev/null

success "Stable ipsets populated."

###############################################################################
# VERIFY STABLE PERMANENT SETS BEFORE ACTIVATING THEM
###############################################################################

info "Verifying stable ipsets in permanent configuration..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    ipset_exists_permanent "${set}" \
        || die "Stable ipset ${set} was not created."

done

success "All stable ipsets exist in permanent configuration."

############################
# Verify stable contents
############################

info "Verifying stable ipset contents..."

verify_ipset_entries \
    "${GEOIP_IP4}" \
    "${GEOIP_IP4_FILE}"

verify_ipset_entries \
    "${GEOIP_IP6}" \
    "${GEOIP_IP6_FILE}"

verify_ipset_entries \
    "${ASN_IP4}" \
    "${ASN_IP4_FILE}"

verify_ipset_entries \
    "${ASN_IP6}" \
    "${ASN_IP6_FILE}"

success "All stable ipset contents verified."

###############################################################################
# ATTACH STABLE SOURCES
###############################################################################

info "Attaching stable ipsets to ${ZONE}..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    if ! zone_source_exists_permanent "${set}"; then

        firewall-cmd \
            --permanent \
            --zone="${ZONE}" \
            --add-source="ipset:${set}" \
            >/dev/null

    fi

done

success "Stable ipsets attached to ${ZONE}."

###############################################################################
# SECOND RELOAD
#
# At this point BOTH staged and stable sets are active.
###############################################################################

info "Reloading firewalld with stable and staged blacklists..."

firewall-cmd --reload >/dev/null

success "Firewalld reloaded."

###############################################################################
# VERIFY STABLE RUNTIME
###############################################################################

info "Verifying stable ipsets in runtime configuration..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    ipset_exists_runtime "${set}" \
        || die "Stable ipset ${set} was not loaded into runtime."

done

success "All stable ipsets are active at runtime."

############################
# Verify stable sources
############################

info "Verifying stable zone sources at runtime..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    zone_source_exists_runtime "${set}" \
        || die "Runtime zone ${ZONE} is missing source ipset:${set}."

done

success "All stable zone sources are active at runtime."

###############################################################################
# REMOVE STAGED SETS
###############################################################################

info "Removing staged zone sources..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    remove_permanent_source "${set}"

done

success "Staged zone sources removed."

############################
# Remove staged ipsets
############################

info "Removing staged ipsets..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    remove_permanent_ipset "${set}"

done

success "Staged ipsets removed."

###############################################################################
# FINAL RELOAD
###############################################################################

info "Performing final firewalld reload..."

firewall-cmd --reload >/dev/null

success "Final firewalld reload complete."

###############################################################################
# FINAL VERIFICATION
###############################################################################

info "Performing final runtime verification..."

############################
# Stable sets must exist
############################

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    ipset_exists_runtime "${set}" \
        || die "Final runtime ipset missing: ${set}"

done

success "All stable runtime ipsets exist."

############################
# Stable sources must exist
############################

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do

    zone_source_exists_runtime "${set}" \
        || die "Final runtime zone ${ZONE} is missing source ipset:${set}"

done

success "All stable runtime zone sources exist."

############################
# Staged sets must NOT exist
############################

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do

    if ipset_exists_runtime "${set}"; then
        die "Staged runtime ipset still exists: ${set}"
    fi

    if ipset_exists_permanent "${set}"; then
        die "Staged permanent ipset still exists: ${set}"
    fi

done

success "No staged ipsets remain."

############################
# Final source listing
############################

echo
info "Final ${ZONE} sources:"

firewall-cmd \
    --zone="${ZONE}" \
    --list-sources

############################
# Final ipset listing
############################

echo
info "Final runtime ipsets:"

firewall-cmd --get-ipsets

############################
# Summary
############################

echo
echo "============================================================"
echo " Update completed successfully"
echo "============================================================"
echo
echo " GeoIP IPv4 : ${GEOIP_COUNT}"
echo " GeoIP IPv6 : ${GEOIP_IP6_COUNT}"
echo " ASN IPv4   : ${ASN_IP4_COUNT}"
echo " ASN IPv6   : ${ASN_IP6_COUNT}"
echo
echo " Countries  : ${ZONES}"
echo " Zone       : ${ZONE}"
echo
echo " Stable ipsets:"
echo "   ${GEOIP_IP4}"
echo "   ${GEOIP_IP6}"
echo "   ${ASN_IP4}"
echo "   ${ASN_IP6}"
echo
echo "============================================================"
