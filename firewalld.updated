#!/bin/bash

# ===========================================================================
# GeoIP + Bad ASN Firewalld Blocker
#
# Downloads country CIDRs from IPdeny and bad ASN information from
# bad-asn-list, expands the ASNs with bgpq4, normalizes the resulting
# networks, and installs them into Firewalld hash:net ipsets.
#
# New lists are built into temporary "-new" ipsets first.
# Existing working ipsets are not removed until the new lists are ready.
# ===========================================================================

set -euo pipefail


# ===========================================================================
# Configuration
# ===========================================================================

# Countries to block.
ZONES="ch cn cl uy"

# Working directory.
BASE_DIR="/var/lib/firewalld-geoip"

# IPdeny aggregated country list.
IPDENY_BASE="https://www.ipdeny.com/ipblocks/data/aggregated"

# Bad ASN list.
ASN_LIST_URL="https://raw.githubusercontent.com/bountyyfi/bad-asn-list/refs/heads/main/all.txt"

# Firewalld zone used for blocking.
BLOCK_ZONE="drop"

# Number of ASNs is small enough to fit comfortably in argv.
# bgpq4 accepts multiple objects and merges them.
#
# This is deliberately NOT used to spawn one bgpq4 process per ASN.
BGPQ4_BATCH_SIZE=500


# ===========================================================================
# Files
# ===========================================================================

COUNTRY_IP4="${BASE_DIR}/country-ipv4.txt"

ASN_RAW="${BASE_DIR}/bad-asn.txt"
ASN_CLEAN="${BASE_DIR}/bad-asn.clean"

ASN_IP4_RAW="${BASE_DIR}/asn-ipv4.raw"
ASN_IP6_RAW="${BASE_DIR}/asn-ipv6.raw"

ASN_IP4_FILE="${BASE_DIR}/asn-ipv4.txt"
ASN_IP6_FILE="${BASE_DIR}/asn-ipv6.txt"


# ===========================================================================
# Stable Firewalld ipsets
# ===========================================================================

GEOIP_IP4="geoip-blacklist-ip4"
GEOIP_IP6="geoip-blacklist-ip6"

ASN_IP4="asn-blacklist-ip4"
ASN_IP6="asn-blacklist-ip6"


# ===========================================================================
# Staged Firewalld ipsets
# ===========================================================================

NEW_GEOIP_IP4="${GEOIP_IP4}-new"
NEW_GEOIP_IP6="${GEOIP_IP6}-new"

NEW_ASN_IP4="${ASN_IP4}-new"
NEW_ASN_IP6="${ASN_IP6}-new"


# ===========================================================================
# Output helpers
# ===========================================================================

info()
{
    echo "[i] $*"
}

ok()
{
    echo "[✓] $*"
}

warn()
{
    echo "[!] $*" >&2
}

fail()
{
    echo "[✗] $*" >&2
    exit 1
}


# ===========================================================================
# Basic checks
# ===========================================================================

[[ "${EUID}" -eq 0 ]] \
    || fail "This script must be run as root."

command -v firewall-cmd >/dev/null 2>&1 \
    || fail "firewall-cmd was not found."

command -v curl >/dev/null 2>&1 \
    || fail "curl was not found."

command -v python3 >/dev/null 2>&1 \
    || fail "python3 was not found."

command -v bgpq4 >/dev/null 2>&1 \
    || fail "bgpq4 was not found."

mkdir -p "${BASE_DIR}"


# ===========================================================================
# Display configuration
# ===========================================================================

info "Configuration:"
echo "      Countries : ${ZONES}"
echo "      Zone      : ${BLOCK_ZONE}"
echo "      Work dir  : ${BASE_DIR}"

echo
echo "      GeoIP IPv4 : ${GEOIP_IP4}"
echo "      GeoIP IPv6 : ${GEOIP_IP6}"
echo "      ASN IPv4   : ${ASN_IP4}"
echo "      ASN IPv6   : ${ASN_IP6}"

echo
echo "      Staged:"
echo "      ${NEW_GEOIP_IP4}"
echo "      ${NEW_GEOIP_IP6}"
echo "      ${NEW_ASN_IP4}"
echo "      ${NEW_ASN_IP6}"


# ===========================================================================
# Clean stale staged ipsets
#
# This MUST happen before attempting to create the staged sets.
#
# These sets are created with --permanent, therefore cleanup also uses
# --permanent.
# ===========================================================================

info "Cleaning stale staged ipsets..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    if firewall-cmd --permanent --get-ipsets \
        | grep -Fxq "${set}"
    then
        info "Removing stale staged ipset ${set}..."

        firewall-cmd --permanent \
            --delete-ipset="${set}" \
            || fail "Failed to remove stale staged ipset ${set}."

        if firewall-cmd --permanent --get-ipsets \
            | grep -Fxq "${set}"
        then
            fail "Staged ipset ${set} still exists after deletion."
        fi

        ok "Removed stale staged ipset ${set}."
    fi
done

ok "Stale staged ipset cleanup complete."


# ===========================================================================
# Check Firewalld
# ===========================================================================

info "Checking Firewalld ipset support..."

firewall-cmd --get-ipsets >/dev/null 2>&1 \
    || fail "Firewalld does not appear to support ipsets."

ok "Firewalld ipsets are supported."


# ===========================================================================
# Download GeoIP lists
# ===========================================================================

info "Downloading GeoIP country lists..."

: > "${COUNTRY_IP4}"

for country in ${ZONES}
do
    URL="${IPDENY_BASE}/${country}-aggregated.zone"
    TMP_FILE="${BASE_DIR}/${country}.zone"

    info "Downloading ${country} IPv4 ranges..."

    curl -fsSL \
        --retry 3 \
        --connect-timeout 20 \
        --max-time 300 \
        "${URL}" \
        -o "${TMP_FILE}" \
        || fail "Failed to download ${URL}"

    [[ -s "${TMP_FILE}" ]] \
        || fail "Downloaded GeoIP file for ${country} is empty."

    cat "${TMP_FILE}" >> "${COUNTRY_IP4}"
done

ok "GeoIP country lists downloaded."


# ===========================================================================
# Normalize GeoIP IPv4
# ===========================================================================

info "Normalizing GeoIP IPv4 prefixes..."

python3 - "${COUNTRY_IP4}" "${COUNTRY_IP4}.normalized" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()

        if not line:
            continue

        try:
            net = ipaddress.ip_network(line, strict=False)
        except ValueError:
            print(
                f"Invalid CIDR in GeoIP list: {line}",
                file=sys.stderr
            )
            sys.exit(1)

        if net.version == 4:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:
    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv4 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

mv "${COUNTRY_IP4}.normalized" "${COUNTRY_IP4}"

ok "GeoIP IPv4: $(wc -l < "${COUNTRY_IP4}") normalized networks."


# ===========================================================================
# Download bad ASN list
# ===========================================================================

info "Downloading bad ASN list..."

curl -fsSL \
    --retry 3 \
    --connect-timeout 20 \
    --max-time 300 \
    "${ASN_LIST_URL}" \
    -o "${ASN_RAW}" \
    || fail "Failed to download bad ASN list."

[[ -s "${ASN_RAW}" ]] \
    || fail "Downloaded ASN list is empty."

ok "Bad ASN list downloaded."


# ===========================================================================
# Parse ASN list
#
# Example:
#
# AS51167 Contabo GmbH
#
# becomes:
#
# 51167
# ===========================================================================

info "Parsing bad ASN list..."

awk '
{
    asn = $1
    sub(/^AS/, "", asn)

    if (asn ~ /^[0-9]+$/)
        print asn
}
' "${ASN_RAW}" \
    | sort -n -u \
    > "${ASN_CLEAN}"

ASN_COUNT="$(wc -l < "${ASN_CLEAN}")"

[[ "${ASN_COUNT}" -gt 0 ]] \
    || fail "No valid ASNs were extracted."

ok "Bad ASN list: ${ASN_COUNT} unique ASNs."


# ===========================================================================
# Build bgpq4 object list
#
# bgpq4 accepts multiple AS objects on the same command line and merges
# their results. This is vastly more efficient than launching bgpq4 once
# for every ASN.
# ===========================================================================

info "Preparing ${ASN_COUNT} ASN objects for bgpq4..."

mapfile -t ASN_OBJECTS < <(
    sed 's/^/AS/' "${ASN_CLEAN}"
)

[[ "${#ASN_OBJECTS[@]}" -eq "${ASN_COUNT}" ]] \
    || fail "Failed to prepare ASN objects."

ok "Prepared ${#ASN_OBJECTS[@]} ASN objects."


# ===========================================================================
# Generate ASN IPv4 prefixes
#
# ONE bgpq4 invocation instead of ~2,200.
# ===========================================================================

info "Generating ASN IPv4 prefixes with bgpq4..."
info "Querying ${ASN_COUNT} ASNs in a single bgpq4 operation..."

: > "${ASN_IP4_RAW}"

if ! bgpq4 \
    -4 \
    -A \
    -F '%n\n' \
    "${ASN_OBJECTS[@]}" \
    > "${ASN_IP4_RAW}"
then
    fail "bgpq4 failed while generating IPv4 prefixes."
fi

ok "ASN IPv4 raw prefixes: $(wc -l < "${ASN_IP4_RAW}")"


# ===========================================================================
# Generate ASN IPv6 prefixes
#
# ONE bgpq4 invocation instead of ~2,200.
# ===========================================================================

info "Generating ASN IPv6 prefixes with bgpq4..."
info "Querying ${ASN_COUNT} ASNs in a single bgpq4 operation..."

: > "${ASN_IP6_RAW}"

if ! bgpq4 \
    -6 \
    -A \
    -F '%n\n' \
    "${ASN_OBJECTS[@]}" \
    > "${ASN_IP6_RAW}"
then
    fail "bgpq4 failed while generating IPv6 prefixes."
fi

ok "ASN IPv6 raw prefixes: $(wc -l < "${ASN_IP6_RAW}")"


# ===========================================================================
# Normalize ASN IPv4
# ===========================================================================

info "Normalizing ASN IPv4 prefixes..."

python3 - "${ASN_IP4_RAW}" "${ASN_IP4_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()

        if not line:
            continue

        try:
            net = ipaddress.ip_network(line, strict=False)
        except ValueError:
            print(
                f"Invalid IPv4 CIDR: {line}",
                file=sys.stderr
            )
            sys.exit(1)

        if net.version == 4:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:
    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv4 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

ok "ASN IPv4: $(wc -l < "${ASN_IP4_FILE}") normalized networks."


# ===========================================================================
# Normalize ASN IPv6
# ===========================================================================

info "Normalizing ASN IPv6 prefixes..."

python3 - "${ASN_IP6_RAW}" "${ASN_IP6_FILE}" <<'PY'
import ipaddress
import sys

src = sys.argv[1]
dst = sys.argv[2]

networks = []

with open(src, "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()

        if not line:
            continue

        try:
            net = ipaddress.ip_network(line, strict=False)
        except ValueError:
            print(
                f"Invalid IPv6 CIDR: {line}",
                file=sys.stderr
            )
            sys.exit(1)

        if net.version == 6:
            networks.append(net)

collapsed = list(ipaddress.collapse_addresses(networks))

with open(dst, "w", encoding="utf-8") as f:
    for net in collapsed:
        f.write(f"{net}\n")

print(
    f"Normalized {len(networks)} IPv6 prefixes -> "
    f"{len(collapsed)} prefixes."
)
PY

ok "ASN IPv6: $(wc -l < "${ASN_IP6_FILE}") normalized networks."


# ===========================================================================
# Validate generated CIDRs
# ===========================================================================

info "Validating generated CIDR lists..."

python3 - \
    "${COUNTRY_IP4}" \
    "${ASN_IP4_FILE}" \
    "${ASN_IP6_FILE}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:
    with open(filename, "r", encoding="utf-8") as f:
        for line_number, line in enumerate(f, 1):
            line = line.strip()

            if not line:
                continue

            try:
                ipaddress.ip_network(line, strict=False)
            except ValueError:
                print(
                    f"Invalid CIDR in {filename}:{line_number}: {line}",
                    file=sys.stderr
                )
                sys.exit(1)

print("CIDR validation passed.")
PY

ok "CIDR validation passed."


# ===========================================================================
# Reject default routes
# ===========================================================================

info "Checking for default routes in ASN lists..."

if grep -Fxq "0.0.0.0/0" "${ASN_IP4_FILE}"; then
    fail "ASN IPv4 list contains 0.0.0.0/0. Refusing to continue."
fi

if grep -Fxq "::/0" "${ASN_IP6_FILE}"; then
    fail "ASN IPv6 list contains ::/0. Refusing to continue."
fi

echo "No IPv4/IPv6 default routes found."

ok "No default routes found."


# ===========================================================================
# Check ASN lists for overlaps
# ===========================================================================

info "Checking ASN lists for overlapping networks..."

python3 - \
    "${ASN_IP4_FILE}" \
    "${ASN_IP6_FILE}" <<'PY'

import ipaddress
import sys

for filename in sys.argv[1:]:
    networks = []

    with open(filename, "r", encoding="utf-8") as f:
        for line in f:
            line = line.strip()

            if not line:
                continue

            networks.append(
                ipaddress.ip_network(line, strict=False)
            )

    networks.sort(
        key=lambda n: (
            int(n.network_address),
            n.prefixlen
        )
    )

    previous = None

    for current in networks:
        if previous is not None and current.subnet_of(previous):
            print(
                f"Overlapping networks in {filename}: "
                f"{previous} contains {current}",
                file=sys.stderr
            )
            sys.exit(1)

        previous = current

print("No overlapping ASN networks found.")
PY

ok "No overlapping ASN networks found."


# ===========================================================================
# Check Firewalld hash:net support
# ===========================================================================

info "Checking Firewalld hash:net ipset support..."

TEST_IPSET="firewalld-hash-net-test"

if firewall-cmd --permanent --get-ipsets \
    | grep -Fxq "${TEST_IPSET}"
then
    firewall-cmd --permanent \
        --delete-ipset="${TEST_IPSET}" \
        || fail "Could not remove old test ipset."
fi

firewall-cmd --permanent \
    --new-ipset="${TEST_IPSET}" \
    --type=hash:net \
    || fail "Firewalld cannot create hash:net ipsets."

firewall-cmd --permanent \
    --delete-ipset="${TEST_IPSET}" \
    || fail "Could not remove Firewalld hash:net test ipset."

ok "hash:net ipsets are supported."


# ===========================================================================
# Create staged blacklist ipsets
# ===========================================================================

info "Creating staged blacklist ipsets..."


# ---------------------------------------------------------------------------
# GeoIP IPv4
# ---------------------------------------------------------------------------

info "Creating IPv4 temporary ipset ${NEW_GEOIP_IP4}..."

firewall-cmd --permanent \
    --new-ipset="${NEW_GEOIP_IP4}" \
    --type=hash:net \
    || fail "Failed to create ${NEW_GEOIP_IP4}."

info "Loading IPv4 entries into ${NEW_GEOIP_IP4}..."

while read -r cidr
do
    [[ -n "${cidr}" ]] || continue

    firewall-cmd --permanent \
        --ipset="${NEW_GEOIP_IP4}" \
        --add-entry="${cidr}" \
        >/dev/null

done < "${COUNTRY_IP4}"

ok "Staged GeoIP IPv4 loaded."


# ---------------------------------------------------------------------------
# GeoIP IPv6
# ---------------------------------------------------------------------------

info "Creating IPv6 temporary ipset ${NEW_GEOIP_IP6}..."

firewall-cmd --permanent \
    --new-ipset="${NEW_GEOIP_IP6}" \
    --type=hash:net \
    --family=inet6 \
    || fail "Failed to create ${NEW_GEOIP_IP6}."

info "${NEW_GEOIP_IP6} has no entries."

ok "Staged GeoIP IPv6 loaded."


# ---------------------------------------------------------------------------
# ASN IPv4
# ---------------------------------------------------------------------------

info "Creating IPv4 temporary ipset ${NEW_ASN_IP4}..."

firewall-cmd --permanent \
    --new-ipset="${NEW_ASN_IP4}" \
    --type=hash:net \
    || fail "Failed to create ${NEW_ASN_IP4}."

info "Loading IPv4 entries into ${NEW_ASN_IP4}..."

while read -r cidr
do
    [[ -n "${cidr}" ]] || continue

    firewall-cmd --permanent \
        --ipset="${NEW_ASN_IP4}" \
        --add-entry="${cidr}" \
        >/dev/null

done < "${ASN_IP4_FILE}"

ok "Staged ASN IPv4 loaded."


# ---------------------------------------------------------------------------
# ASN IPv6
# ---------------------------------------------------------------------------

info "Creating IPv6 temporary ipset ${NEW_ASN_IP6}..."

firewall-cmd --permanent \
    --new-ipset="${NEW_ASN_IP6}" \
    --type=hash:net \
    --family=inet6 \
    || fail "Failed to create ${NEW_ASN_IP6}."

info "Loading IPv6 entries into ${NEW_ASN_IP6}..."

while read -r cidr
do
    [[ -n "${cidr}" ]] || continue

    firewall-cmd --permanent \
        --ipset="${NEW_ASN_IP6}" \
        --add-entry="${cidr}" \
        >/dev/null

done < "${ASN_IP6_FILE}"

ok "Staged ASN IPv6 loaded."


# ===========================================================================
# Verify staged ipsets in PERMANENT configuration
# ===========================================================================

info "Verifying staged ipsets in permanent configuration..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    if ! firewall-cmd --permanent --get-ipsets \
        | grep -Fxq "${set}"
    then
        fail "Staged ipset ${set} was not created in permanent configuration."
    fi
done

ok "All staged ipsets exist in permanent configuration."


# ===========================================================================
# Verify staged entry counts
# ===========================================================================

info "Checking staged ipset entry counts..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    count="$(
        firewall-cmd \
            --permanent \
            --ipset="${set}" \
            --get-entries \
        | sed '/^[[:space:]]*$/d' \
        | wc -l
    )"

    info "${set}: ${count} entries"
done

ok "Staged ipset entry checks complete."


# ===========================================================================
# Attach staged ipsets to drop zone
# ===========================================================================

info "Attaching staged ipsets to ${BLOCK_ZONE}..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    firewall-cmd --permanent \
        --zone="${BLOCK_ZONE}" \
        --add-source="ipset:${set}" \
        || fail "Failed to attach ${set} to ${BLOCK_ZONE}."
done

ok "All staged ipsets attached to ${BLOCK_ZONE}."


# ===========================================================================
# First reload
#
# Existing stable sets remain in place while the staged sets become active.
# ===========================================================================

info "Reloading Firewalld..."

firewall-cmd --reload \
    || fail "Firewalld reload failed."

ok "Firewalld reloaded."


# ===========================================================================
# Verify staged ipsets in RUNTIME configuration
# ===========================================================================

info "Verifying staged ipsets in runtime configuration..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    if ! firewall-cmd --get-ipsets \
        | grep -Fxq "${set}"
    then
        fail "Staged ipset ${set} is not active in runtime configuration."
    fi
done

ok "All staged ipsets are active at runtime."


# ===========================================================================
# Verify staged zone sources
# ===========================================================================

info "Verifying staged drop-zone sources..."

for set in \
    "${NEW_GEOIP_IP4}" \
    "${NEW_GEOIP_IP6}" \
    "${NEW_ASN_IP4}" \
    "${NEW_ASN_IP6}"
do
    if ! firewall-cmd --zone="${BLOCK_ZONE}" --list-sources \
        | tr ' ' '\n' \
        | grep -Fxq "ipset:${set}"
    then
        fail "Staged ipset ${set} is not attached to ${BLOCK_ZONE}."
    fi
done

ok "All staged ipsets are attached to ${BLOCK_ZONE} at runtime."


# ===========================================================================
# Remove old stable zone sources
# ===========================================================================

info "Removing old stable blacklist sources..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    if firewall-cmd --permanent --zone="${BLOCK_ZONE}" --list-sources \
        | tr ' ' '\n' \
        | grep -Fxq "ipset:${set}"
    then
        firewall-cmd --permanent \
            --zone="${BLOCK_ZONE}" \
            --remove-source="ipset:${set}" \
            || fail "Failed to remove old source ipset:${set}."
    fi
done

ok "Old stable blacklist sources removed."


# ===========================================================================
# Remove old stable ipsets
# ===========================================================================

info "Removing old stable ipsets..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    if firewall-cmd --permanent --get-ipsets \
        | grep -Fxq "${set}"
    then
        firewall-cmd --permanent \
            --delete-ipset="${set}" \
            || fail "Failed to remove old ipset ${set}."

        if firewall-cmd --permanent --get-ipsets \
            | grep -Fxq "${set}"
        then
            fail "Old ipset ${set} still exists after deletion."
        fi
    fi
done

ok "Old stable ipsets removed."


# ===========================================================================
# Rename staged ipsets to stable names
# ===========================================================================

info "Renaming staged ipsets to stable names..."

firewall-cmd --permanent \
    --rename-ipset="${NEW_GEOIP_IP4}" \
    --newname="${GEOIP_IP4}" \
    || fail "Failed to rename ${NEW_GEOIP_IP4}."

firewall-cmd --permanent \
    --rename-ipset="${NEW_GEOIP_IP6}" \
    --newname="${GEOIP_IP6}" \
    || fail "Failed to rename ${NEW_GEOIP_IP6}."

firewall-cmd --permanent \
    --rename-ipset="${NEW_ASN_IP4}" \
    --newname="${ASN_IP4}" \
    || fail "Failed to rename ${NEW_ASN_IP4}."

firewall-cmd --permanent \
    --rename-ipset="${NEW_ASN_IP6}" \
    --newname="${ASN_IP6}" \
    || fail "Failed to rename ${NEW_ASN_IP6}."

ok "Staged ipsets renamed to stable names."


# ===========================================================================
# Attach stable ipsets
# ===========================================================================

info "Attaching stable blacklist ipsets to ${BLOCK_ZONE}..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    firewall-cmd --permanent \
        --zone="${BLOCK_ZONE}" \
        --add-source="ipset:${set}" \
        || fail "Failed to attach ${set} to ${BLOCK_ZONE}."
done

ok "Stable blacklist ipsets attached."


# ===========================================================================
# Final reload
# ===========================================================================

info "Performing final Firewalld reload..."

firewall-cmd --reload \
    || fail "Final Firewalld reload failed."

ok "Final Firewalld reload complete."


# ===========================================================================
# Final runtime verification
# ===========================================================================

info "Performing final runtime verification..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    if ! firewall-cmd --get-ipsets \
        | grep -Fxq "${set}"
    then
        fail "Final runtime ipset ${set} is missing."
    fi
done

ok "All stable ipsets are active at runtime."


# ===========================================================================
# Final zone verification
# ===========================================================================

info "Verifying final ${BLOCK_ZONE} zone sources..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    if ! firewall-cmd --zone="${BLOCK_ZONE}" --list-sources \
        | tr ' ' '\n' \
        | grep -Fxq "ipset:${set}"
    then
        fail "Final ipset ${set} is not attached to ${BLOCK_ZONE}."
    fi
done

ok "All blacklist ipsets are attached to ${BLOCK_ZONE}."


# ===========================================================================
# Final permanent verification
# ===========================================================================

info "Verifying final permanent configuration..."

for set in \
    "${GEOIP_IP4}" \
    "${GEOIP_IP6}" \
    "${ASN_IP4}" \
    "${ASN_IP6}"
do
    if ! firewall-cmd --permanent --get-ipsets \
        | grep -Fxq "${set}"
    then
        fail "Final permanent ipset ${set} is missing."
    fi
done

ok "Final permanent ipset configuration verified."


# ===========================================================================
# Final summary
# ===========================================================================

echo
echo "============================================================"
echo " Firewalld blacklist update complete"
echo "============================================================"
echo
echo "GeoIP IPv4 : ${GEOIP_IP4}"
echo "GeoIP IPv6 : ${GEOIP_IP6}"
echo "ASN IPv4   : ${ASN_IP4}"
echo "ASN IPv6   : ${ASN_IP6}"
echo

echo "GeoIP IPv4 entries:"
firewall-cmd --ipset="${GEOIP_IP4}" --get-entries | wc -l

echo "GeoIP IPv6 entries:"
firewall-cmd --ipset="${GEOIP_IP6}" --get-entries | wc -l

echo "ASN IPv4 entries:"
firewall-cmd --ipset="${ASN_IP4}" --get-entries | wc -l

echo "ASN IPv6 entries:"
firewall-cmd --ipset="${ASN_IP6}" --get-entries | wc -l

echo
echo "Drop zone sources:"
firewall-cmd --zone="${BLOCK_ZONE}" --list-sources

echo
echo "============================================================"
